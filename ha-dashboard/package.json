{
  "name": "ha-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:panel": "tsc -b && vite build --config vite.panel.config.ts --mode panel",
    "build:builder": "tsc -b && vite build --config vite.builder.config.ts --mode panel",
    "lint": "oxlint",
    "test": "npx tsx --test 'src/**/*.test.ts'",
    "preview": "vite preview",
    "prettier": "prettier --write .",
    "sync": "npx tsx scripts/sync-types.ts",
    "prebuild": "npm run prettier",
    "deploy": "npx tsx scripts/deploy.ts",
    "measure": "npx tsx scripts/measure-panel.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@hakit/components": "^6.0.2",
    "@hakit/core": "^6.0.2",
    "@use-gesture/react": "^10.3.1",
    "fullcalendar": "6.1.21",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylis": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^6.0.0",
    "dotenv": "^18.0.1",
    "node-scp": "^0.0.25",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "prompts": "^2.4.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
